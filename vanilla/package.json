{
  "name": "vanilla-tailwind-interview-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"*.{js,html,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\" \"*.{js,html,json,md}\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.2"
  }
}
